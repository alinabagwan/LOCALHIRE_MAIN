# LocalHire Backend - Environment Variables Template
# Copy this file to .env and configure values for your environment.
# Never commit the actual .env file or real secrets to version control.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5500

# CORS — set to the exact origin of your frontend (no trailing slash)
# For local file:// HTML pages use: http://localhost:5500  or  http://127.0.0.1:5500
ALLOWED_ORIGIN=http://localhost:5500

# Authentication (JWT Secret)
# Generate a cryptographically strong secret in production: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# PostgreSQL Connection String (configured on target database server)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?schema=public
# Example for local development on target machine:
# DATABASE_URL="postgresql://localhire_user:your_secure_password@localhost:5432/localhire_db?schema=public"
# Example for SSL / Managed PostgreSQL:
# DATABASE_URL="postgresql://localhire_user:your_secure_password@db.example.com:5432/localhire_db?sslmode=require&schema=public"
DATABASE_URL=postgresql://localhire_user:change_me_to_real_password@localhost:5432/localhire_db?schema=public

# Legacy MongoDB Connection String (retained during transitional period)
# MONGODB_URI=mongodb://localhost:27017/localhire
