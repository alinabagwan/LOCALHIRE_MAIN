{
  "name": "localhire-backend",
  "version": "1.0.0",
  "description": "Backend API server for LocalHire platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$p = Get-NetTCPConnection -LocalPort 5000 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if ($p) { foreach ($id in $p) { Stop-Process -Id $id -Force } }; node --watch server.js\"",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "db:check": "node scripts/check-db.js",
    "db:import": "node scripts/import-from-mongodb.js"
  },
  "keywords": [
    "localhire",
    "express",
    "mongodb",
    "socket.io",
    "geospatial"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
